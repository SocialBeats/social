# MongoDB Configuration (containerizado, SIN autenticación)
MONGOADMIN=
MONGOPASS=
MONGOURL=mongodb://mongodb:27017/microservice-social
MONGOTESTURL=mongodb://mongodb:27017/microservice-social_test

# Application Configuration
NODE_ENV=development
PORT=3004
LOG_LEVEL=info

# Security
JWT_SECRET=dev_secret_change_in_production

# API Documentation
API_TITLE="Social microservice API"
API_DESCRIPTION="This is an OAS description of this social microservice REST API"

# Kafka Configuration
ENABLE_KAFKA=true
KAFKA_BROKER=kafka:9092
KAFKA_CONNECTION_MAX_RETRIES=10
KAFKA_CONNECTION_RETRY_DELAY=3000
KAFKA_COOLDOWN=30000
